import numpy as np
cvalues = [-17.78, -11.11, 7.34, 1.11, 37.73, 0]
C = np.array(cvalues)
print("Values in Centigrade degrees:") 
print(C)
print("Values in Fahrenheit degrees:") 
print(np.round((9*C/5 + 32),2)) 

